# Skopiuj do .env i dostosuj. Plik .env jest opcjonalny —
# bez niego aplikacja wystartuje na domyślnych wartościach.

# Adres nasłuchu. Domyślnie tylko ta maszyna.
# Do pracy w sieci domowej: 0.0.0.0:8080 (i koniecznie ustaw APP_TOKEN).
APP_ADDR=127.0.0.1:8080

# Katalog z bazą i plikami. To jedyne miejsce ze stanem aplikacji.
DATA_DIR=./data

# Pusty = brak jakiejkolwiek autoryzacji (dobre na localhoście).
# Niepusty = metody zapisu (POST/PUT/PATCH/DELETE) wymagają nagłówka
# X-App-Token o tej wartości. Odczyt zostaje otwarty.
APP_TOKEN=

# Limit rozmiaru pojedynczego uploadu w megabajtach.
MAX_UPLOAD_MB=512

# "dev" włącza logi tekstowe i poziom debug; cokolwiek innego = JSON, poziom info.
APP_ENV=dev
